{
  "name": "d3b-binarize-image",
  "label": "Binarize an image",
  "description": "Binarizes an input image.",
  "author": "D3b-TIRU",
  "maintainer": "D3b-TIRU <flywheel@d3b.center>",
  "url": "https://github.com/d3b-center/fw-binarize-image", 
  "source": "https://github.com/d3b-center/fw-binarize-image", 
  "version": "0.0.0",
  "license": "Apache-2.0",
  "custom": {
    "flywheel": {
      "suite": "D3b-TIRU"
    },
    "gear-builder": {
      "category": "utility",
      "image": "chop.flywheel.io/d3b-binarize-image:0.0.0"
    }
  },
  "inputs": {
    "input-file": {
      "base": "file",
      "description": "Input image.",
      "optional": false,
      "type": {
        "enum": [
          "nifti"
        ]
      }
    },
    "api-key": {
      "base": "api-key",
      "read-only": true
    }
  },
  "config": {
    "output-filename": {
      "description": "Output file name (.nii or .nii.gz). Default: <input name>_bin.nii.gz.",
      "type": "string"
    },
    "debug": {
      "default": false,
      "description": "Log debug messages",
      "type": "boolean"
    }
  },
  "environment": {
    "PATH": "/opt/poetry/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "PYTHON_VERSION": "3.9.7",
    "PIP_NO_CACHE_DIR": "0",
    "POETRY_HOME": "/opt/poetry",
    "POETRY_VERSION": "1.1.11",
    "POETRY_VIRTUALENVS_CREATE": "false",
    "FLYWHEEL": "/flywheel/v0"
  },
  "command": "python run.py"
}